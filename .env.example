# Clave Pública de EmailJS (Account Public Key)
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=fc4QxiMiBJhDBwCbH

# ID del Servicio de Email configurado en EmailJS (Gmail)
NEXT_PUBLIC_EMAILJS_SERVICE_ID=service_gmail_jeta_us

# ID de la Plantilla de Email creada en EmailJS
